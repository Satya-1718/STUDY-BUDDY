MONGO_URI=mongodb://127.0.0.1:27017/studybuddy
GEMINI_API_KEY=your_gemini_key_here
JWT_SECRET=change_this_to_any_long_random_text
PORT=3000

# Optional: comma-separated model list, tried in order
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite

# Optional: set true for demos. Review intervals become minutes instead of days.
DEMO_MODE=false

# --- RAG (Chat with your notes) ---
# Embedding model used to turn text into vectors (change if Google retires it)
# GEMINI_EMBED_MODEL=gemini-embedding-001

# Default: similarity search runs in Node (works with any MongoDB).
# Set true ONLY after creating the Atlas Vector Search index named vector_index.
USE_ATLAS_VECTOR=false

# --- Roles ---
# If set, people registering as Teacher must type this code (stops students from self-promoting).
# TEACHER_INVITE_CODE=choose_a_secret_word

# Head of department sign-up. REQUIRED to register as HOD; if unset, HOD sign-up is disabled.
# HOD_INVITE_CODE=choose_another_secret_word
